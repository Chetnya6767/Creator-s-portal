# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# Agency & Contact Configuration
VITE_SITE_NAME="Production Partner"
CONTACT_EMAIL="schetnya136@gmail.com"
ADMIN_EMAIL="schetnya136@gmail.com"
FORMSPREE_ENDPOINT=""

# Payment Provider Configuration
# Set to direct UPI QR mode for instant zero-fee transfers via FamApp / Google Pay / PhonePe / Paytm
PAYMENT_PROVIDER="upi_qr"
PAYMENT_WEBHOOK_SECRET="prod_partner_secret_wh_2026"

# Enter your FamApp UPI ID here (e.g. yourname@fam or username@fam)
# This is the ONLY variable you need to fill!
VITE_UPI_ID="YOUR_FAMAPP_ID@fam"
UPI_ID="YOUR_FAMAPP_ID@fam"

# Third-party merchant credentials (leave blank for FamApp / direct UPI)
PAYMENT_API_KEY=""
PAYMENT_SECRET=""

# Analytics Tracking ID (Optional: Google Analytics / Plausible)
ANALYTICS_ID=""
